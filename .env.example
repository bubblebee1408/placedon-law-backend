# PlacedOn — environment template. COPY to `.env`, never commit the copy.
#
# Every variable here is one the code actually reads. The list was produced by sweeping for
# `os.environ` and `getenv` lookups rather than written from memory, because a template that
# documents a variable nothing reads sends somebody to configure a thing with no effect --
# and omitting one that IS read is how a deployment fails with no symptom.
#
# `checker/env.load()` does NOT override a variable already set in the environment, so
# exporting wins over this file. That is deliberate: a shell export is a decision somebody
# just made.
#
# WHO ISSUES EACH KEY, WHAT IT UNLOCKS AND WHAT IT COSTS: docs/guides/INTEGRATIONS_CHECKLIST.md
#
# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED for anything beyond an in-memory run
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Unset means an in-memory store that keeps nothing across a restart, which
# `gateway/store.select()` allows and says out loud. SET but unusable is an ERROR, never a
# silent fall back to memory: an operator who configured a database and got a dict would be
# told everything is fine while nothing persists and no policy isolates anyone.
PLACEDON_DATABASE_URL=postgresql:///placedon_app_local?host=/tmp

# The migration/admin role, used ONLY by scripts/rls_integration.py. Never by the gateway:
# a superuser bypasses row-level security entirely, which is why that script asserts
# isolation as `placedon_app` and not as this.
PLACEDON_ADMIN_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 2. MODEL PROVIDERS — one of these, or the product abstains on every model path
# ─────────────────────────────────────────────────────────────────────────────
#
# Residency: production is AWS Mumbai (ap-south-1). The Azure deployment below is UAE North
# and is TEST-ONLY -- PUBLIC or SYNTHETIC documents only, never a client contract. Every
# review carries that fact on screen (`playbook_status: DRAFT` plus the hosting note), and
# the `test_data` input is the caller stating this document is a fixture.

# Azure AI (UAE North). TEST ONLY. See above.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Set to the exact region string to acknowledge you have read the residency note above.
PLACEDON_ACCEPT_REGION=

# Anthropic, Gemini, Sarvam, Voyage. Each unlocks the model paths in its own module and
# nothing else; with none set, every model path refuses rather than guessing.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
SARVAM_API_KEY=
VOYAGE_API_KEY=

# `mock` keeps every model path deterministic and free. Anything else needs a key above.
LLM_MODE=mock
LLM_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────────
# 3. SOURCE CONNECTORS (G1) — skeletons today, live when keyed
# ─────────────────────────────────────────────────────────────────────────────
#
# With the key UNSET, each connector RAISES `KEY_MISSING` on every read. It does not return
# an empty list: an empty list would say "there is nothing to find" about a search that never
# happened, and an abstention built on that would be a verified product state resting on a
# fiction.

# Indian Kanoon. Tier LICENSED -- found and quoted, never verified law. Its licence requires
# attribution, which `checker/sources/terms.py` records verbatim and the connector carries.
PLACEDON_INDIANKANOON_KEY=

# data.gov.in (OGD). Tier OFFICIAL_LIVE -- what the dataset says today, never what the law
# said on a date. A `resource_id` is required per query; there is no default dataset.
PLACEDON_DATA_GOV_IN_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 4. BEHAVIOUR SWITCHES
# ─────────────────────────────────────────────────────────────────────────────

# The critic (job 6b). Default OFF. Recorded on every run and in the trace either way, so
# "found nothing" and "was not running" are distinguishable afterwards -- they look identical
# in the answer.
CRITIC_ENABLED=0

# Set by scripts/serve_ask.py and the gate to serve fixtures instead of calling anything.
PLACEDON_ASK_FIXTURES=

# Themis live feeds (egazette, ibbi). Unset means fixtures.
THEMIS_LIVE=

# ─────────────────────────────────────────────────────────────────────────────
# 5. PRESENT IN THE CODE, NOT USED IN PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────
#
# `checker/ollama_runner.py` and `backend/services/llm.py` still read these. Listed because
# they are read, and marked because the standing deployment rule is NO LOCAL MODELS -- so
# setting them changes behaviour on a developer's laptop and must not be relied on anywhere
# else.
OLLAMA_BASE_URL=
OLLAMA_HOST=
OLLAMA_MODEL=

# Only `checker/robots.py`, and only when a system CA bundle is not where Python expects it.
SSL_CERT_FILE=
