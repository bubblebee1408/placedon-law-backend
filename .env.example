# PlacedOn — environment template. `make dev` copies it to `.env` (gitignored) and fills
# PLACEDON_GATEWAY_SERVICE_KEY with a fresh random value. Never commit the copy, and never
# put a production value here: production settings live in Azure App Service.
#
# No inline comments after a value: checker/env.py would read them as part of the value.
#
# Every variable here is one the code actually reads. The list was produced by sweeping for
# `os.environ` and `getenv` lookups rather than written from memory, because a template that
# documents a variable nothing reads sends somebody to configure a thing with no effect --
# and omitting one that IS read is how a deployment fails with no symptom.
#
# `checker/env.load()` does NOT override a variable already set in the environment, so
# exporting wins over this file. That is deliberate: a shell export is a decision somebody
# just made.
#
# WHO ISSUES EACH KEY, WHAT IT UNLOCKS AND WHAT IT COSTS: docs/guides/INTEGRATIONS_CHECKLIST.md
#
# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED for anything beyond an in-memory run
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. Unset means an in-memory store that keeps nothing across a restart, which
# `gateway/store.select()` allows and says out loud. SET but unusable is an ERROR, never a
# silent fall back to memory: an operator who configured a database and got a dict would be
# told everything is fine while nothing persists and no policy isolates anyone.
# The default is the local compose database (`make dev`), as the app role placedon_app
# (NOSUPERUSER NOBYPASSRLS); inside containers compose.yaml points it at host `db` instead.
PLACEDON_DATABASE_URL=postgresql://placedon_app:local-only-not-a-secret@localhost:55432/placedon

# A superuser/BYPASSRLS URL on the SAME database, used ONLY by scripts/migrate.py for its
# pg_dump backup (the app role cannot read rows RLS hides from it). Migrations still run as
# the app role.
PLACEDON_BACKUP_DATABASE_URL=

# The migration/admin role, used ONLY by scripts/rls_integration.py. Never by the gateway:
# a superuser bypasses row-level security entirely, which is why that script asserts
# isolation as `placedon_app` and not as this.
PLACEDON_ADMIN_DATABASE_URL=

# The gateway's service credential: the web app's SERVER holds the same key (Vercel
# PLACEDON_GATEWAY_KEY); a browser never does. A 43-character URL-safe token from
# `python3 -c 'import secrets;print(secrets.token_urlsafe(32))'`. The three are set together
# or not at all (startup fails on a partial set); the key always acts as role `lawyer`.
# The tenant and actor below are the local ones ops/dev/bootstrap.sql creates.
PLACEDON_GATEWAY_SERVICE_KEY=
PLACEDON_GATEWAY_TENANT_ID=00000000-0000-0000-0000-000000000001
PLACEDON_GATEWAY_ACTOR_ID=00000000-0000-0000-0000-000000000002

# Which tenant's job queue `python -m gateway.worker --serve` drains. Required with a
# database: one worker serves one tenant. compose.yaml sets it to the tenant above.
PLACEDON_WORKER_TENANT_ID=

# The vault (uploaded files): a local directory OR an Azure Blob container, never both.
# Neither means uploads are refused NO_VAULT by name. compose.yaml sets a local directory.
PLACEDON_FILES_DIR=
# Production: a private container reached by managed identity (az login works locally).
PLACEDON_AZURE_BLOB_ACCOUNT_URL=
PLACEDON_AZURE_BLOB_CONTAINER=

# ─────────────────────────────────────────────────────────────────────────────
# 2. MODEL PROVIDERS — one of these, or the product abstains on every model path
# ─────────────────────────────────────────────────────────────────────────────
#
# Residency: production is AWS Mumbai (ap-south-1). The Azure deployment below is UAE North
# and is TEST-ONLY -- PUBLIC or SYNTHETIC documents only, never a client contract. Every
# review carries that fact on screen (`playbook_status: DRAFT` plus the hosting note). A
# request cannot mark a document as a fixture: client text is refused there until an
# operator sets PLACEDON_ACCEPT_REGION, and only in-process tests (Context.synthetic_fixtures)
# may send fixtures.

# Azure AI (UAE North). TEST ONLY. See above.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=
# Set to the exact region string to acknowledge you have read the residency note above.
PLACEDON_ACCEPT_REGION=

# Claude on Amazon Bedrock, ap-south-1 (checker/bedrock_model.py), through boto3's default
# credential chain. Blocked while the AWS account is on the free plan.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# A comma list that can only NARROW the providers the gateway may call: azure,bedrock,ollama.
# Unset means every provider that is configured.
PLACEDON_MODEL_PROVIDERS=

# Anthropic, Gemini, Sarvam, Voyage. Each unlocks the model paths in its own module and
# nothing else; with none set, every model path refuses rather than guessing.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
SARVAM_API_KEY=
# Only the founder writes `confirmed` here, after opting out of Sarvam's training use.
SARVAM_TRAINING_OPT_OUT=
VOYAGE_API_KEY=
# Public web research is disabled until provider terms and workspace data egress are approved.
PLACEDON_EXA_WEB_ENABLED=0
EXA_API_KEY=

# `mock` keeps every model path deterministic and free. Anything else needs a key above.
LLM_MODE=mock
LLM_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────────
# 3. SOURCE CONNECTORS (G1) — skeletons today, live when keyed
# ─────────────────────────────────────────────────────────────────────────────
#
# With the key UNSET, each connector RAISES `KEY_MISSING` on every read. It does not return
# an empty list: an empty list would say "there is nothing to find" about a search that never
# happened, and an abstention built on that would be a verified product state resting on a
# fiction.

# Indian Kanoon. Tier LICENSED -- found and quoted, never verified law. Its licence requires
# attribution, which `checker/sources/terms.py` records verbatim and the connector carries.
PLACEDON_INDIANKANOON_KEY=

# data.gov.in (OGD). Tier OFFICIAL_LIVE -- what the dataset says today, never what the law
# said on a date. A `resource_id` is required per query; there is no default dataset.
PLACEDON_DATA_GOV_IN_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 4. BEHAVIOUR SWITCHES
# ─────────────────────────────────────────────────────────────────────────────

# The critic (job 6b). Default OFF. Recorded on every run and in the trace either way, so
# "found nothing" and "was not running" are distinguishable afterwards -- they look identical
# in the answer.
CRITIC_ENABLED=0

# Ask "as of" a past date (2014-04-01 to today), rebuilt from India Code's amendment notes.
# Default OFF until the Legal Lead has reviewed a sample of past-date answers; off means a
# past as_of is refused with AS_OF_UNSUPPORTED exactly as before.
PLACEDON_ASK_AS_OF=0

# Set by scripts/serve_ask.py and the gate to serve fixtures instead of calling anything.
PLACEDON_ASK_FIXTURES=

# Themis live feeds (egazette, ibbi). Unset means fixtures.
THEMIS_LIVE=

# Serve /openapi.json. Local only: it is served before auth, so on a deployment it is a map.
PLACEDON_OPENAPI=

# Connection pool for the Postgres rate limiter, and the cap on queued conversation turns.
PLACEDON_RATE_LIMIT_POOL_SIZE=10
PLACEDON_CONVERSATION_QUEUE_LIMIT=100

# ─────────────────────────────────────────────────────────────────────────────
# 5. PRESENT IN THE CODE, NOT USED IN PRODUCTION
# ─────────────────────────────────────────────────────────────────────────────
#
# `checker/ollama_runner.py` and `backend/services/llm.py` still read these. Listed because
# they are read, and marked because the standing deployment rule is NO LOCAL MODELS -- so
# setting them changes behaviour on a developer's laptop and must not be relied on anywhere
# else.
OLLAMA_BASE_URL=
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_S=

# Only `checker/robots.py`, and only when a system CA bundle is not where Python expects it.
SSL_CERT_FILE=

# ─────────────────────────────────────────────────────────────────────────────
# 6. compose.yaml only: host ports for the local stack
# ─────────────────────────────────────────────────────────────────────────────
PLACEDON_DB_PORT=55432
PLACEDON_GATEWAY_PORT=8000
