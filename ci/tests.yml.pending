# Runs the identical script the pre-commit hook runs. Never a reimplementation of the suite list:
# two copies of the definition of "green" drift, and the drift is discovered as a false green.
name: tests

on:
  push:
  pull_request:

# The suites only read the repo. Nothing here needs write access or a token.
permissions:
  contents: read

# A superseded push has nothing left to tell us; cancel it rather than queue it.
concurrency:
  group: tests-${{ github.ref }}
  cancel-in-progress: true

jobs:
  suites:
    runs-on: ubuntu-latest
    # MEASURED 2026-09-25: the full sweep is 219s (196 suites) on the author's laptop.
    # Twenty minutes is ~5x that, so this fires on "hung", never on "a slower runner".
    # The comment used to say "the suite is ~4s", written when there were 25 suites.
    # A number in a comment rots; this one carries the date it was taken.
    timeout-minutes: 20

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: requirements-dev.txt

      # The day anticipated below has arrived, so the claim above it is gone rather than left
      # to mislead. checker/pdf_pages.py imports pypdf (pinned in requirements-dev.txt), and
      # checker/sarvam_model.py and sarvam_selftest.py do too. The suite therefore CANNOT run
      # green without this step, and a workflow asserting otherwise would be the same class of
      # stale claim as the "~4s" above and the lawyer sentence M1.3 fixed.
      #
      # The original reason for installing stands and is now load-bearing rather than
      # precautionary: CI must be a superset of a normal dev machine, so that a suite importing
      # a third-party package cannot go red here while every laptop stays green.
      - run: python -m pip install --disable-pip-version-check -r requirements-dev.txt

      # MEASURED, NOT PREDICTED (2026-09-14): a checkout of this repo with no local artifacts
      # failed exactly one suite -- checker/provenance.py -- because both PDFs it hashes are
      # matched by the `*.pdf` line in .gitignore and are therefore not in the clone.
      # NOT RE-MEASURED SINCE. PLAN_17 M1.1 names five suites it expects to fail from a clean
      # clone (pypdf, a chmod-000 test that a root user can read anyway, a missing s96 witness,
      # and scripts/review.py --test). Whichever count is right, the first green CI run on a
      # fresh runner is the measurement -- not this comment, and not the author's laptop. That is a real finding about the
      # repo, not a CI defect, so this workflow does NOT exclude the suite: one definition of
      # green is the whole point. It only labels the failure so nobody spends an hour on it.
      # Resolve by tracking the artifacts (LFS or an unignore rule) or by teaching provenance.py
      # to distinguish "artifact absent" from "artifact wrong". Then delete this step.
      - name: Flag artifacts that a clone cannot contain
        run: |
          for f in corpus/sources/companies_act_2013_indiacode.pdf \
                   corpus/sources/companies_meetings_board_powers_rules_2014.pdf; do
            [ -f "$f" ] || echo "::warning file=checker/provenance.py::$f is gitignored and absent from a fresh checkout; checker/provenance.py will fail below for this reason alone."
          done

      - run: ./scripts/run_tests.sh
