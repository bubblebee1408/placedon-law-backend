__pycache__/
.claude/index.json
.DS_Store
.env
.env.local
.venv/
.vercel
*.pdf
# ...but NOT the source artifacts the provenance chain hashes. A blanket *.pdf
# kept them out of the repo, so a fresh clone failed five suites and the whole
# "hashed local artifact plus human review equals VERIFIED" claim could not be
# checked from a clean checkout. A provenance chain whose evidence is not in the
# repository is one in name only.
!corpus/sources/*.pdf
# Also the signed documents the signature and revocation suites verify. These
# are public listed-company disclosures, a permitted source. The exact BYTES
# matter here in a way they rarely do: what is under test is a cryptographic
# signature over a byte range, so re-downloading a re-issued copy would not
# reproduce the test. 24 MB into a private repo is the correct trade against
# four suites that cannot run anywhere but one laptop.
!corpus/testdocs/_raw/*.pdf
*.pyc
corpus/.asks.jsonl
corpus/.budget.json
corpus/.checks.jsonl
corpus/raw/*.pdf
# ...but NOT the source artifacts the provenance chain hashes. A blanket *.pdf
# kept them out of the repo, so a fresh clone failed five suites and the whole
# "hashed local artifact plus human review equals VERIFIED" claim could not be
# checked from a clean checkout. A provenance chain whose evidence is not in the
# repository is one in name only.
!corpus/sources/*.pdf
# Also the signed documents the signature and revocation suites verify. These
# are public listed-company disclosures, a permitted source. The exact BYTES
# matter here in a way they rarely do: what is under test is a cryptographic
# signature over a byte range, so re-downloading a re-issued copy would not
# reproduce the test. 24 MB into a private repo is the correct trade against
# four suites that cannot run anywhere but one laptop.
!corpus/testdocs/_raw/*.pdf
corpus/review_pack.html
corpus/review_response.json
corpus/sample_*.html
corpus/sample_board_report.html
frontend/.env.local
node_modules/
venv/

# Rendered letters. Regenerate with scripts/draft_letters.py; do not track output.
outbox/

# Never. Credentials live in ~/.placedon/, outside the repo.
.placedon/
*gmail_credentials*.json
*gmail_token*.json

# Cached third-party source pages. Our verdicts are ours to publish; Indian
# Kanoon's page copies are not. Attribution is not the same as redistribution.
corpus/corroboration/*.html

# Reviewer identity map. Benchmark files carry pseudonymous reviewer IDs;
# the real identities stay local and are not distributed.
corpus/benchmark/.reviewer_identities.json

# Cached CRLs. Retrieved from the issuing CA; integrity comes from their
# signature, not from us storing them.
corpus/trust/crl/
corpus/.dense_cache.pkl
corpus/.chunk_dense_cache.pkl
